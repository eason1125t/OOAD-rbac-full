# 复制为 .env；本文件不包含真实凭据。发版前把三个应用镜像改为集群可拉取的仓库标签。
RBAC_STACK_NAME=c2
RBAC_CONFIG_VERSION=v1
RBAC_DATA_NODE=replace-with-swarm-data-node
RBAC_HTTP_PORT=8080
RBAC_SESSION_SECURE=false
RBAC_FRONTEND_IMAGE=rbac-c2/frontend:delivery
RBAC_FUNC_IMAGE=rbac-c2/backend-func:delivery
RBAC_OO_IMAGE=rbac-c2/backend-oo:delivery
RBAC_MAVEN_IMAGE=maven:3.9.11-eclipse-temurin-21
RBAC_JAVA_IMAGE=eclipse-temurin:21-jre-noble
RBAC_NODE_IMAGE=node:24-alpine
RBAC_NGINX_IMAGE=nginx:1.28-alpine
RBAC_MYSQL_IMAGE=mysql:8.4.7
RBAC_REDIS_IMAGE=redis:7.4.6-alpine
