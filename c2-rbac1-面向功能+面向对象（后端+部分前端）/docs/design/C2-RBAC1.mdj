        {
          "_type": "UMLActivity",
          "_id": "c2-uml-02915",
          "name": "41-shared-申请并发状态竞争-活动图",
          "nodes": [
            {
              "_type": "UMLInitialNode",
              "_id": "c2-uml-02917",
              "name": "",
              "_parent": {
                "$ref": "c2-uml-02915"
              }
            },
            {
              "_type": "UMLAction",
              "_id": "c2-uml-02919",
              "name": "同一 PENDING 申请：审批请求与本人撤回请求并发到达",
              "_parent": {
                "$ref": "c2-uml-02915"
              }
            },
            {
              "_type": "UMLAction",
              "_id": "c2-uml-02921",
              "name": "各事务执行 findLockedByIdAndDeletedAtIsNull\nMySQL 悲观写锁决定谁先继续；另一事务等待",
              "_parent": {
                "$ref": "c2-uml-02915"
              }
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "c2-uml-02923",
              "name": "",
              "_parent": {
                "$ref": "c2-uml-02915"
              }
            },
            {
              "_type": "UMLAction",
              "_id": "c2-uml-02925",
              "name": "审批先持锁：实时 read+approve 检查\n状态 PENDING → APPROVED",
              "_parent": {
                "$ref": "c2-uml-02915"
              }
            },
            {
              "_type": "UMLAction",
              "_id": "c2-uml-02927",
              "name": "撤回先持锁：实时 read+withdraw 和本人检查\n状态 PENDING → WITHDRAWN",
              "_parent": {
                "$ref": "c2-uml-02915"
              }
            },
            {
              "_type": "UMLAction",
              "_id": "c2-uml-02929",
              "name": "审批事务提交并释放锁；成功日志 COMMITTED\n审批响应 200",
              "_parent": {
                "$ref": "c2-uml-02915"
              }
            },
            {
              "_type": "UMLAction",
              "_id": "c2-uml-02931",
              "name": "撤回事务提交并释放锁；成功日志 COMMITTED\n撤回响应 200",
              "_parent": {
                "$ref": "c2-uml-02915"
              }
            },
            {
              "_type": "UMLAction",
              "_id": "c2-uml-02933",
              "name": "等待的撤回事务取得锁，读到 APPROVED\n本人检查后，待审批状态检查失败",
              "_parent": {
                "$ref": "c2-uml-02915"
              }
            },
            {
              "_type": "UMLAction",
              "_id": "c2-uml-02935",
              "name": "等待的审批事务取得锁，读到 WITHDRAWN\n待审批状态检查失败",
              "_parent": {
                "$ref": "c2-uml-02915"
              }
            },
            {
              "_type": "UMLAction",
              "_id": "c2-uml-02937",
