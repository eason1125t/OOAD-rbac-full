              }
            },
            {
              "_type": "UMLAction",
              "_id": "c2-uml-02703",
              "name": "AdminDirectory 请求 page/pageSize\n后端按管理范围筛选；拒绝则显示错误并结束",
              "_parent": {
                "$ref": "c2-uml-02697"
              }
            },
            {
              "_type": "UMLAction",
              "_id": "c2-uml-02705",
